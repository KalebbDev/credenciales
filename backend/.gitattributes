# Normaliza todos los archivos de texto al estilo de salto de línea según el sistema local
* text=auto

# Fuerza LF para archivos de código fuente (para coherencia en equipos mixtos)
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Archivos binarios (Git no los toca)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary

# Evita conflictos de saltos de línea con lockfiles
package-lock.json text eol=lf

# Si usas shell scripts
*.sh     text eol=lf

# Para Prettier si formateas archivos Markdown o YAML
*.prettierrc text eol=lf
*.eslintrc text eol=lf